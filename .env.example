# Only required for AI extraction, generation and validation with enough evidence.
OPENROUTER_API_KEY=
# Required in server runtime: PostgreSQL pooled URL from your provider.
DATABASE_URL=
# Optional direct, unpooled URL for migrations/import. CLI falls back to DATABASE_URL.
DIRECT_URL=

# Required canonical origin outside localhost. Use HTTPS in deployment.
# APP_ORIGIN=https://foundry.your-domain.com

# Netlify uses public DEPLOY_PRIME_URL / URL build metadata as origin fallback.
# Set secrets in Netlify UI, scoped to Functions/runtime and relevant contexts.
# Never run migrations/import in a deploy-preview build.
