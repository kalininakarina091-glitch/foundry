# Only required for AI extraction, generation and validation with enough evidence.
OPENROUTER_API_KEY=
# Optional override; by default Prisma uses prisma/dev.db.
# DATABASE_URL=file:/absolute/path/to/foundry/prisma/dev.db

# Required canonical origin outside localhost. Use HTTPS in deployment.
# APP_ORIGIN=https://foundry.your-domain.com

# Netlify uses public DEPLOY_PRIME_URL / URL build metadata as origin fallback.
# This SQLite version intentionally disables database operations on Netlify.
# A persistent external provider must be separately approved and implemented.
